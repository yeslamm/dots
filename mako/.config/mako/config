# ==============================================================================
# GLOBAL NOTIFICATION STYLE (UPSCALED)
# ==============================================================================

font=JetBrains Mono 12
background-color=#17181a
text-color=#ffffff
border-color=#60686e
border-size=2
border-radius=0
default-timeout=3000
width=500
height=800
padding=10
margin=15
progress-color=#60686e
markup=1
max-visible=5
layer=overlay

# ==============================================================================
# URGENCY LEVELS
# ==============================================================================

[urgency=low]
background-color=#17181a
text-color=#8a8f93
border-color=#3f4447
default-timeout=2000

[urgency=normal]
background-color=#17181a
text-color=#ffffff
border-color=#60686e
default-timeout=3000

[urgency=high]
background-color=#232527
text-color=#ffffff
border-color=#d93a49
default-timeout=0
