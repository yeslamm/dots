#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-play-pause}"
PARAM="${2:-}"
FMT="{{markup_escape(artist)}} - {{markup_escape(title)}}"

get_meta() {
    playerctl metadata --format "$FMT" 2>/dev/null || true
}

notify() {
    notify-send -t 1500 -h string:x-canonical-private-synchronous:media "$1" "$2"
}

case "$ACTION" in
shift | unshift)
    playerctld "$ACTION"
    notify "Active Player" "$(playerctl metadata --format '{{playerName}}' 2>/dev/null || echo 'Unknown')"
    exit 0
    ;;
seek)
    playerctl position "${PARAM:-5+}" 2>/dev/null || true
    exit 0
    ;;
play-pause)
    playerctl play-pause 2>/dev/null || true
    sleep 0.08
    STATUS=$(playerctl status 2>/dev/null) || exit 0
    [[ "$STATUS" == "Playing" ]] && TITLE="Now Playing" || TITLE="Paused"
    METADATA=$(get_meta)
    ;;
next | prev | previous)
    OLD_META=$(get_meta)
    if [[ "$ACTION" == "next" ]]; then
        playerctl next 2>/dev/null || true
        TITLE="Next Track"
    else
        playerctl previous 2>/dev/null || true
        TITLE="Previous Track"
    fi

    METADATA=""
    for _ in {1..16}; do
        sleep 0.05
        METADATA=$(get_meta)
        [[ -n "$METADATA" && "$METADATA" != "$OLD_META" ]] && break
    done
    playerctl status >/dev/null 2>&1 || exit 0
    ;;
*)
    echo "Usage: $(basename "$0") {play-pause|next|prev|seek [offset]|shift|unshift}" >&2
    exit 1
    ;;
esac

METADATA="${METADATA# - }"
METADATA="${METADATA% - }"
notify "$TITLE" "${METADATA:-Unknown Track}"
