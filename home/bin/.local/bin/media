#!/usr/bin/env bash

set -euo pipefail

ACTION="${1:-play-pause}"
PARAM="${2:-}"

SLEEP_TIME=0.08
TITLE=""

OLD_META=$(playerctl metadata --format "{{markup_escape(artist)}} - {{markup_escape(title)}}" 2>/dev/null || echo "")

case "$ACTION" in
shift | unshift)
    playerctld "$ACTION"
    PLAYER_NAME=$(playerctl metadata --format '{{playerName}}' 2>/dev/null || echo "Unknown")
    notify-send "Active Player" "$PLAYER_NAME" -t 1500 -h string:x-canonical-private-synchronous:media
    exit 0
    ;;
seek)
    OFFSET="${PARAM:-5+}"
    playerctl position "$OFFSET" 2>/dev/null || true
    exit 0
    ;;
play-pause)
    playerctl play-pause 2>/dev/null || true
    sleep "$SLEEP_TIME"
    ;;
next)
    playerctl next 2>/dev/null || true
    TITLE="Next Track"
    ;;
prev | previous)
    playerctl previous 2>/dev/null || true
    TITLE="Previous Track"
    ;;
*)
    echo "Usage: $0 {play-pause|next|prev|seek [offset]|shift|unshift}" >&2
    exit 1
    ;;
esac

if [[ "$ACTION" == "next" || "$ACTION" == "prev" || "$ACTION" == "previous" ]]; then
    METADATA=""
    for _ in {1..16}; do
        sleep 0.05
        METADATA=$(playerctl metadata --format "{{markup_escape(artist)}} - {{markup_escape(title)}}" 2>/dev/null || echo "")
        if [[ -n "$METADATA" && "$METADATA" != "$OLD_META" ]]; then
            break
        fi
    done
else
    METADATA=$(playerctl metadata --format "{{markup_escape(artist)}} - {{markup_escape(title)}}" 2>/dev/null || echo "")
fi

STATUS=$(playerctl status 2>/dev/null) || exit 0

METADATA="${METADATA# - }"

if [[ -z "$METADATA" ]]; then
    METADATA="Unknown Track"
fi

if [[ "$ACTION" == "play-pause" ]]; then
    if [[ "$STATUS" == "Playing" ]]; then
        TITLE="Now Playing"
    else
        TITLE="Paused"
    fi
fi

notify-send "$TITLE" "$METADATA" -t 1500 -h string:x-canonical-private-synchronous:media
