#!/usr/bin/env bash

set -euo pipefail

NOTIFY=false
for arg in "$@"; do
    case "$arg" in
    -n | --notify | notify) NOTIFY=true ;;
    esac
done

if swaymsg -t get_outputs | jq -e '.[0].allow_tearing == true' >/dev/null 2>&1; then
    swaymsg "output * allow_tearing no; output * max_render_time 3"
    MSG="Allow Tearing: OFF"
else
    swaymsg "output * allow_tearing yes; output * max_render_time off"
    MSG="Allow Tearing: ON"
fi

if [[ "$NOTIFY" == true ]]; then
    notify-send -t 1000 -h string:x-canonical-private-synchronous:vsync "$MSG"
fi
