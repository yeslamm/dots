#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
region) args=(--freeze save area) ;;
window) args=(save active) ;;
fullscreen) args=(save output) ;;
*)
    echo "Usage: $(basename "$0") {region|window|fullscreen}" >&2
    exit 1
    ;;
esac

TMP_IMG="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/satty-XXXXXX.png")"
trap 'rm -f "$TMP_IMG"' EXIT

grimshot "${args[@]}" "$TMP_IMG" >/dev/null || exit 0
notify-send -t 1500 "Screenshot" "Captured to scratchpad"
satty --filename "$TMP_IMG" --title "Satty - $(date '+%Y-%m-%d %H:%M:%S')"
