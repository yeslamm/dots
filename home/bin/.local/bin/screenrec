#!/usr/bin/env bash

set -euo pipefail

ACTION="${1:-}"
VID_DIR="$HOME/Videos"
LOG_FILE="${XDG_RUNTIME_DIR:-/tmp}/screenrec.log"
TMP_GEOM=""

cleanup() {
    [[ -n "${TMP_GEOM:-}" && -f "$TMP_GEOM" ]] && rm -f "$TMP_GEOM"
}
trap cleanup EXIT INT TERM

if [[ ! -t 1 ]]; then
    exec >"$LOG_FILE" 2>&1
fi

if pgrep -f "^gpu-screen-recorder" >/dev/null; then
    pkill -SIGINT -f "^gpu-screen-recorder"
    notify-send -t 2000 "Screen Recorder" "Recording stopped and saved to ~/Videos"
    exit 0
fi

if [[ -z "$ACTION" ]]; then
    echo "Usage: $(basename "$0") [region|window|fullscreen]" >&2
    exit 1
fi

mkdir -p "$VID_DIR"
OUTPUT_FILE="$VID_DIR/rec_$(date +%Y-%m-%d_%H-%M-%S).mp4"

case "$ACTION" in
region)
    TMP_GEOM="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/geom-XXXXXX")"

    wayfreeze --after-freeze-cmd "slurp -d -w 1 -c '#78a9ff' -s '#78a9ff1a' -b '#0f0f0f55' -f '%wx%h+%x+%y' > '$TMP_GEOM'; pkill wayfreeze" || true

    GEOM=$(<"$TMP_GEOM")

    cleanup

    [[ -z "$GEOM" ]] && exit 0

    notify-send -t 1500 "Screen Recorder" "Recording region..."
    exec gpu-screen-recorder -w region -region "$GEOM" -f 60 -a "default_output" -o "$OUTPUT_FILE"
    ;;

window)
    notify-send -t 1500 "Screen Recorder" "Select window in portal..."
    exec gpu-screen-recorder -w portal -f 60 -a "default_output" -o "$OUTPUT_FILE"
    ;;

fullscreen)
    notify-send -t 1500 "Screen Recorder" "Recording screen..."
    exec gpu-screen-recorder -w screen -f 60 -a "default_output" -o "$OUTPUT_FILE"
    ;;

*)
    echo "Usage: $(basename "$0") {region|window|fullscreen}" >&2
    exit 1
    ;;
esac
