#!/usr/bin/env bash
set -euo pipefail

TARGET="${1:-}"
ACTION="${2:-}"
WOB_SOCK="${XDG_RUNTIME_DIR:-/run/user/${UID}}/wob.sock"
STEP="5"

send_wob() {
    [[ -n "${1:-}" && -p "$WOB_SOCK" ]] && printf '%s\n' "$1" >"$WOB_SOCK"
}

case "$TARGET" in
vol)
    case "$ACTION" in
    up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *) exit 1 ;;
    esac

    read -r _ raw_vol status <<<"$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"
    if [[ "${status:-}" == *"[MUTED]"* ]]; then
        send_wob 0
    else
        IFS='.' read -r int frac <<<"$raw_vol"
        frac="${frac}00"
        send_wob "$((10#$int * 100 + 10#${frac:0:2}))"
    fi
    ;;

mic)
    case "$ACTION" in
    toggle) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 ;;
    unmute) wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 0 ;;
    *) exit 1 ;;
    esac

    status="Unmuted"
    [[ "$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)" == *"[MUTED]"* ]] && status="Muted"
    notify-send -t 1000 -h string:x-canonical-private-synchronous:mic "Microphone: $status"
    ;;

brightness)
    case "$ACTION" in
    up) arg="${STEP}%+" ;;
    down) arg="${STEP}%-" ;;
    *) exit 1 ;;
    esac

    IFS=',' read -r _ _ _ perc _ <<<"$(brightnessctl -m set "$arg")"
    send_wob "${perc%?}"
    ;;

*)
    echo "Usage: $(basename "$0") {vol|mic|brightness} <action>" >&2
    exit 1
    ;;
esac
