# ==============================================================================
#  SWAY CONFIGURATION
# ==============================================================================

# ==============================================================================
#  1. VARIABLES & PATHS
# ==============================================================================

include /etc/sway/config.d/*
exec dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM ELECTRON_OZONE_PLATFORM_HINT ELECTRON_ENABLE_FEATURES MOZ_ENABLE_WAYLAND _JAVA_AWT_WM_NONREPARENTING LIBVA_DRIVER_NAME VDPAU_DRIVER AMD_VULKAN_ICD


set $mod Mod4
set $term kitty
set $f_term $term --title=float-term
set $menu fuzzel
set $scripts ~/.config/sway/scripts

set $files      exec $term -e yazi
set $g_files    pcmanfm

# ==============================================================================
#  2. HARDWARE: INPUT & OUTPUT
# ==============================================================================

output * bg ~/Pictures/archlogosquares.jpg fill

input type:keyboard {
    xkb_layout "us,ara"
    xkb_capslock disabled
    xkb_options "grp:alt_shift_toggle"
    repeat_delay 190
    repeat_rate 60
}

input type:touchpad {
    accel_profile adaptive
    pointer_accel 0.4
    scroll_factor 0.8
    dwt enabled
    tap enabled
    tap_button_map lrm
    drag_lock disabled
}

bindgesture swipe:3:left workspace prev
bindgesture swipe:3:right workspace next

exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors-r3'
    gsettings set org.gnome.desktop.interface cursor-size 24
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE
}

seat * xcursor_theme capitaine-cursors-r3 24
seat * hide_cursor when-typing enable
mouse_warping output

# ==============================================================================
#  3. AUTOSTART
# ==============================================================================

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec input-remapper-control --command autoload
exec swaync
exec easyeffects --hide-window
exec gammastep -l 31.11167:30.94583

exec nm-applet --indicator
exec sleep 1 && blueman-applet
exec_always "pkill -x waybar; sleep 0.5; waybar"

exec copyq --start-server
exec $scripts/idle-mgr.sh
exec flameshot

exec wpctl set-volume @DEFAULT_SINK@ 0.30
exec wpctl set-volume @DEFAULT_SOURCE@ 0.40
exec amixer -c 1 set 'Internal Mic Boost' 0

# ==============================================================================
#  4. APPEARANCE & THEME
# ==============================================================================

xwayland enable
default_border pixel 4
default_floating_border normal 4
smart_borders on
gaps inner 8
smart_gaps on

font pango:JetBrains Mono 11
titlebar_border_thickness 0
titlebar_padding 4 2
title_align center

# Syntax:                border     bg         text       indicator  child_border
client.focused           #60686e    #60686e    #ffffff    #aaaaaa    #60686e
client.focused_inactive  #3f4447    #2b2e30    #cccccc    #45494d    #17181a
client.unfocused         #17181a    #17181a    #8a8f93    #17181a    #17181a
client.urgent            #232527    #232527    #ffffff    #d93a49    #d93a49

# ==============================================================================
#  5. WINDOW RULES
# ==============================================================================

# Specific Apps
for_window [app_id="fdm"] floating enable, resize set 1100 800, move position center, move scratchpad
for_window [app_id="org.qbittorrent.qBittorrent"] floating enable, resize set 1300 900, move position center
for_window [class="com-abdownloadmanager-desktop-AppKt"] floating enable
for_window [app_id="FileRoller"] floating enable
for_window [app_id="org.strawberrymusicplayer.strawberry"] floating enable
for_window [app_id="com.github.hluk.copyq"] floating enable, resize set 1800 1100, move position center
for_window [app_id="mpv"] floating enable
for_window [app_id="swayimg"] floating enable

# System / Portals / Dialogs
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, sticky enable
for_window [instance="sun-awt-X11-XDialogPeer"] floating enable
for_window [window_role="pop-up|bubble|task_dialog|dialog|menu"] floating enable
for_window [app_id="pavucontrol|nm-connection-editor|blueman-manager|blueman-services|syncthingtray"] floating enable, sticky enable

for_window [title="float-term"] floating enable, resize set 1100 800, move position center, title_format ""
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [app_id="firefox" title="^Extension:.*"] floating enable

# ==============================================================================
#  6. KEYBINDINGS: CORE
# ==============================================================================

bindsym $mod+Return             exec $term
bindsym $mod+Shift+Return       exec $f_term
bindsym $mod+space              exec $menu

bindsym --to-code {
    $mod+y        exec $files
    $mod+Shift+y  exec $f_term -e yazi
    $mod+g        exec $g_files
    $mod+b        exec $term -e btop
    $mod+Shift+b  exec $f_term -e btop

    $mod+q        kill
    $mod+x        exec $scripts/fuzzel-kill.sh TERM
    $mod+Shift+x  exec $scripts/fuzzel-kill.sh KILL
    $mod+Shift+r  reload
}

# ==============================================================================
#  7. NAVIGATION & LAYOUT
# ==============================================================================

bindsym  $mod+tab               focus mode_toggle

bindsym --to-code {
    $mod+h        focus left
    $mod+j        focus down
    $mod+k        focus up
    $mod+l        focus right

    $mod+Shift+h  move left
    $mod+Shift+j  move down
    $mod+Shift+k  move up
    $mod+Shift+l  move right

    $mod+Shift+period  move workspace to output next
    $mod+Shift+comma   move workspace to output prev
    $mod+grave         workspace back_and_forth

    $mod+w             layout tabbed
    $mod+e             layout toggle split
    $mod+z             layout stacking

    $mod+semicolon     split v
    $mod+apostrophe    split h

    $mod+Shift+f       floating toggle
    $mod+f             fullscreen
    
    $mod+s             scratchpad show
    $mod+Shift+s       move scratchpad

    Control+$mod+h  resize shrink width 40px
    Control+$mod+j  resize grow height 40px
    Control+$mod+k  resize shrink height 40px
    Control+$mod+l  resize grow width 40px
}

floating_modifier $mod normal

# ==============================================================================
#  8. WORKSPACES
# ==============================================================================

bindsym --to-code {
    $mod+1 workspace number 1
    $mod+2 workspace number 2
    $mod+3 workspace number 3
    $mod+4 workspace number 4
    $mod+5 workspace number 5
    $mod+6 workspace number 6
    $mod+7 workspace number 7
    $mod+8 workspace number 8
    $mod+9 workspace number 9

    $mod+Shift+1 move container to workspace number 1
    $mod+Shift+2 move container to workspace number 2
    $mod+Shift+3 move container to workspace number 3
    $mod+Shift+4 move container to workspace number 4
    $mod+Shift+5 move container to workspace number 5
    $mod+Shift+6 move container to workspace number 6
    $mod+Shift+7 move container to workspace number 7
    $mod+Shift+8 move container to workspace number 8
    $mod+Shift+9 move container to workspace number 9
}

# ==============================================================================
#  9. UTILITIES & HARDWARE
# ==============================================================================

# Hardware keys (Native Support)
bindsym --locked {
    XF86MonBrightnessDown exec $scripts/bright.sh down
    XF86MonBrightnessUp   exec $scripts/bright.sh up
    XF86AudioRaiseVolume  exec $scripts/vol.sh up
    XF86AudioLowerVolume  exec $scripts/vol.sh down
    XF86AudioMute         exec $scripts/vol.sh mute
    XF86AudioPlay         exec $scripts/media.sh play-pause
    XF86AudioNext         exec playerctl next
    XF86AudioPrev         exec playerctl previous
}

# Universal Controls (Mnemonic & Right-Hand Zone)
bindsym --to-code --locked {
    $mod+minus        exec $scripts/vol.sh down
    $mod+equal        exec $scripts/vol.sh up
    $mod+0            exec $scripts/vol.sh mute

    $mod+bracketleft  exec $scripts/bright.sh down
    $mod+bracketright exec $scripts/bright.sh up

    $mod+comma        exec playerctl previous
    $mod+period       exec playerctl next
    $mod+slash        exec $scripts/media.sh play-pause
}

# Desktop Utilities
bindsym --to-code {
    $mod+Shift+n  exec swaync-client -t -sw
    $mod+Shift+c  exec swaync-client --close-latest
    $mod+i        exec $scripts/idle-mgr.sh
    $mod+o        exec $scripts/idle-off.sh
    $mod+v        exec copyq toggle
}

# Screenshots
bindsym --to-code Control+Shift+s exec --no-startup-id flameshot gui -c
bindsym --to-code Control+Mod1+s  exec --no-startup-id flameshot gui -p ~/Pictures/Screenshots
bindsym Print                     exec --no-startup-id flameshot full -c && notify-send -t 1000 "Screenshot copied"
bindsym Shift+Print               exec --no-startup-id flameshot full -p ~/Pictures/Screenshots && notify-send -t 1000 "Screenshot saved"

# ==============================================================================
# 10. MODES
# ==============================================================================

# -- Super Mode --
bindsym $mod+Escape mode Super

mode Super {
    bindsym --to-code {
        # System States (Lock, Suspend, Exit, Reboot, Poweroff)
        l exec $scripts/lock-ns.sh, mode default
        s exec "swaylock -f -c 000000 -F -e -k -L && systemctl suspend", mode default
        e exec $scripts/powermenu.sh logout, mode default
        r exec $scripts/powermenu.sh reboot, mode default
        p exec $scripts/powermenu.sh poweroff, mode default

        # Network & Bluetooth
        w exec "rfkill toggle wifi && notify-send -t 1500 'WiFi Toggled'", mode default
        Shift+w exec nm-connection-editor, mode default
        b exec "rfkill toggle bluetooth && notify-send -t 1500 'Bluetooth Toggled'", mode default
        Shift+b exec blueman-manager, mode default

        # Hardware & System
        t exec $term -e watch -n 2.5 -d sensors, mode default
        g exec $scripts/toggle_gammastep.sh, mode default
        u exec $term -e sh -c 'sudo pacman -Syu && yay -Syua; read -p "Press enter to exit..."', mode default
        a exec $term -e sh -c 'alsamixer', mode default
        v exec pavucontrol, mode default
    }

    # Exit mode
    bindsym Escape mode default
    bindsym Return mode default
    bindsym $mod+Escape mode default
}

# -- Asus Mode --
bindsym XF86Launch1 mode Asus
bindsym --to-code $mod+a mode Asus

mode Asus {
    bindsym --to-code {
        # Power Profiles (Saver, Balanced, Performance)
        s exec powerprofilesctl set power-saver \
            && notify-send -t 1500 -h string:x-canonical-private-synchronous:asus "Profile: Power Saver", mode "default"

        b exec powerprofilesctl set balanced \
            && notify-send -t 1500 -h string:x-canonical-private-synchronous:asus "Profile: Balanced", mode "default"

        p exec powerprofilesctl set performance \
            && notify-send -t 1500 -h string:x-canonical-private-synchronous:asus "Profile: Performance", mode "default"

        # Battery Charging (Limit, Full)
        l exec asusctl battery limit 60 \
            && notify-send -t 1500 -h string:x-canonical-private-synchronous:asus "Battery: Limit set to 60%", mode default

        f exec asusctl battery oneshot \
            && notify-send -t 1500 -h string:x-canonical-private-synchronous:asus "Battery: Charging to 100%", mode default
    }

    # Exit mode
    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym XF86Launch1 mode "default"
    bindsym --to-code $mod+a mode "default"
}
