# ====================================================================================================
#  SWAY CONFIGURATION
# ====================================================================================================

# ==================================================================================================== #
# =========== 1. VARIABLES & PATHS =================================================================== #
# ==================================================================================================== #

include /etc/sway/config.d/*

exec dbus-update-activation-environment --systemd \
    XDG_CURRENT_DESKTOP=sway:wlroots \
    XCURSOR_THEME \
    XCURSOR_SIZE \
    I3SOCK

set $mod         Mod4
set $term        foot
set $float_term  $term --app-id=fterm
set $menu        fuzzel
set $scripts     ~/.config/sway/scripts

set $tc          --to-code
set $lk          --locked
set $tc_lk       --to-code --locked
set $rl_lk       --release --to-code

# ==================================================================================================== #
# =========== 2. HARDWARE: INPUT & OUTPUT ============================================================ #
# ==================================================================================================== #

output * bg #000000 solid_color
output eDP-1 max_render_time 3

input type:keyboard {
    xkb_layout   "us,ara"
    xkb_options  grp:win_space_toggle,altwin:menu_win
    repeat_delay 190
    repeat_rate  60
}

input type:touchpad {
    accel_profile   adaptive
    pointer_accel   0.4
    scroll_factor   0.8
    dwt             enabled
    tap             enabled
    tap_button_map  lrm
    drag_lock       enabled
}

bindgesture swipe:3:right workspace next
bindgesture swipe:3:left  workspace prev

bindswitch $lk lid:on exec $scripts/lid_action.sh
seat * xcursor_theme capitaine-cursors-r3 24
seat * hide_cursor when-typing enable
mouse_warping output

# ==================================================================================================== #
# =========== 3. AUTOSTART =========================================================================== #
# ==================================================================================================== #

exec gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors-r3'
exec gsettings set org.gnome.desktop.interface cursor-size 24
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec sh -c 'source ~/.config/sway/geo && wlsunset -l $LAT -L $LON -t 4500 -T 6500'

exec mako
exec rm -f "$XDG_RUNTIME_DIR/wobpipe" \
    && mkfifo "$XDG_RUNTIME_DIR/wobpipe" \
    && tail -f "$XDG_RUNTIME_DIR/wobpipe" | wob -c ~/.config/wob/wob.ini

exec wl-paste --type text  --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec_always pkill -x -USR2 waybar || (sleep 0.5 && waybar)

exec wpctl set-volume @DEFAULT_SINK@ 0.30
exec wpctl set-volume @DEFAULT_SOURCE@ 0.40
exec easyeffects --hide-window
exec amixer -c 1 set 'Internal Mic Boost' 0

exec $scripts/idlemgr.sh ON
exec wayland-pipewire-idle-inhibit -q

# ==================================================================================================== #
# =========== 4. APPEARANCE & THEME ================================================================== #
# ==================================================================================================== #

default_border           pixel 1
default_floating_border  normal 1
smart_borders            on
gaps inner               0
smart_gaps               on

font pango:JetBrainsMono NF, Vazirmatn 11
titlebar_padding 4 4
titlebar_border_thickness 1
title_align      center

# class                  border   backgr.  text     indic.   child_border
client.focused           #78a9ff  #262626  #dfdfe0  #08bdba  #78a9ff
client.focused_tab_title #262626  #262626  #dfdfe0
client.focused_inactive  #393939  #262626  #dfdfe0  #08bdba  #393939
client.unfocused         #393939  #161616  #6f6f6f  #161616  #393939
client.urgent            #ee5396  #262626  #ffffff  #ee5396  #ee5396

# ==================================================================================================== #
# =========== 5. WINDOW RULES ======================================================================== #
# ==================================================================================================== #

for_window [app_id="qBittorrent"] floating enable, resize set 1300 900, move position center
for_window [app_id="fterm"] floating enable, resize set 1100 800, move position center
for_window [app_id="clipfzf"] floating enable, resize set 1920 1150, move position center

for_window [app_id="FileRoller|mpv|swayimg|gpu_screen_recorder|xdg-desktop-portal-gtk"] floating enable
for_window [instance="sun-awt-X11-XDialogPeer"] floating enable
for_window [window_role="^(pop-up|bubble|task_dialog|dialog|menu)$"] floating enable
for_window [app_id="pavucontrol"] floating enable, sticky enable
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [app_id="firefox" title="^Extension:.*"] floating enable

for_window [app_id="(?i)mpv|zathura|qbittorrent|steam|gamescope|\.exe"] inhibit_idle focus
for_window [class="(?i)mpv|zathura|qbittorrent|steam|gamescope|\.exe"] inhibit_idle focus

# ==================================================================================================== #
# =========== 6. KEYBINDINGS: CORE =================================================================== #
# ==================================================================================================== #

bindsym $mod+Return                 exec $term
bindsym $mod+Shift+Return           exec $float_term
bindsym $tc $mod+d                  exec $menu

bindsym $tc $mod+y                  exec $term yazi
bindsym $tc $mod+Shift+y            exec $float_term yazi
bindsym $tc $mod+b                  exec $term btop
bindsym $tc $mod+Shift+b            exec $float_term btop

bindsym $tc $mod+q                  kill
bindsym --whole-window $mod+button2 kill
bindsym $tc $mod+Shift+r            reload

# ==================================================================================================== #
# =========== 7. NAVIGATION & LAYOUT ================================================================= #
# ==================================================================================================== #

bindsym $mod+tab focus mode_toggle

bindsym $tc $mod+h                focus left
bindsym $tc $mod+j                focus down
bindsym $tc $mod+k                focus up
bindsym $tc $mod+l                focus right

bindsym $tc $mod+Shift+h          move left  40 px
bindsym $tc $mod+Shift+j          move down  40 px
bindsym $tc $mod+Shift+k          move up    40 px
bindsym $tc $mod+Shift+l          move right 40 px

bindsym $tc Control+$mod+h        resize shrink width  40 px
bindsym $tc Control+$mod+j        resize grow   height 40 px
bindsym $tc Control+$mod+k        resize shrink height 40 px
bindsym $tc Control+$mod+l        resize grow   width  40 px

bindsym $tc $mod+w                layout tabbed
bindsym $tc $mod+e                layout toggle split
bindsym $tc $mod+apostrophe       split h
bindsym $tc $mod+semicolon        split v
bindsym $tc $mod+Shift+apostrophe split none
bindsym $tc $mod+Shift+semicolon  split none

bindsym $tc $mod+f                fullscreen
bindsym $tc $mod+Shift+f          floating toggle
bindsym $tc $mod+Control+f        sticky toggle
bindsym $tc $mod+Shift+c          move position center
bindsym $tc $mod+a                focus parent
bindsym $tc $mod+c                focus child
floating_modifier $mod normal

bindsym $tc $mod+grave           workspace back_and_forth
bindsym $tc $mod+Shift+grave     move container to workspace back_and_forth; workspace back_and_forth

bindsym $tc $mod+s               scratchpad show
bindsym $tc $mod+Shift+s         move scratchpad

# ==================================================================================================== #
# =========== 8. WORKSPACES ========================================================================== #
# ==================================================================================================== #

bindsym $tc $mod+1 workspace number 1
bindsym $tc $mod+2 workspace number 2
bindsym $tc $mod+3 workspace number 3
bindsym $tc $mod+4 workspace number 4
bindsym $tc $mod+5 workspace number 5
bindsym $tc $mod+6 workspace number 6
bindsym $tc $mod+7 workspace number 7
bindsym $tc $mod+8 workspace number 8
bindsym $tc $mod+9 workspace number 9

bindsym $tc $mod+Shift+1 move container to workspace number 1
bindsym $tc $mod+Shift+2 move container to workspace number 2
bindsym $tc $mod+Shift+3 move container to workspace number 3
bindsym $tc $mod+Shift+4 move container to workspace number 4
bindsym $tc $mod+Shift+5 move container to workspace number 5
bindsym $tc $mod+Shift+6 move container to workspace number 6
bindsym $tc $mod+Shift+7 move container to workspace number 7
bindsym $tc $mod+Shift+8 move container to workspace number 8
bindsym $tc $mod+Shift+9 move container to workspace number 9

# ==================================================================================================== #
# =========== 9. UTILITIES & HARDWARE ================================================================ #
# ==================================================================================================== #

bindsym $lk XF86AudioRaiseVolume            exec $scripts/vol.sh up
bindsym $lk XF86AudioLowerVolume            exec $scripts/vol.sh down
bindsym $lk XF86AudioMute                   exec $scripts/vol.sh mute
bindsym $lk XF86AudioPlay                   exec $scripts/media.sh play-pause
bindsym $lk XF86AudioNext                   exec playerctl next
bindsym $lk XF86AudioPrev                   exec playerctl previous

bindsym $tc_lk $mod+equal                   exec $scripts/vol.sh up
bindsym $tc_lk $mod+minus                   exec $scripts/vol.sh down
bindsym $tc_lk $mod+0                       exec $scripts/vol.sh mute

bindsym $tc_lk $mod+period                  exec playerctl next
bindsym $tc_lk $mod+comma                   exec playerctl previous
bindsym $tc_lk $mod+slash                   exec $scripts/media.sh play-pause

bindsym $lk XF86MonBrightnessUp             exec $scripts/bright.sh up
bindsym $lk XF86MonBrightnessDown           exec $scripts/bright.sh down
bindsym $tc_lk $mod+bracketright            exec $scripts/bright.sh up
bindsym $tc_lk $mod+bracketleft             exec $scripts/bright.sh down

bindsym $tc $mod+Shift+bracketright         opacity plus 0.1
bindsym $tc $mod+Shift+bracketleft          opacity minus 0.1

bindsym $tc $mod+n                          exec makoctl dismiss
bindsym $tc $mod+Shift+n                    exec makoctl invoke
bindsym $tc $mod+i                          exec $scripts/idlemgr.sh ON
bindsym $tc $mod+o                          exec $scripts/idlemgr.sh OFF

set $clip_term                              $term --app-id=clipfzf
bindsym $tc $mod+v                          exec $clip_term $scripts/cliphist-fzf.sh

bindsym $tc Print                           exec $scripts/screenshot.sh region-copy
bindsym $tc Shift+Print                     exec $scripts/screenshot.sh grim-copy
bindsym $rl_lk Mod1+Print                   exec $scripts/screenshot.sh window-copy

bindsym $tc Control+Print                   exec $scripts/screenshot.sh region-save
bindsym $tc Control+Shift+Print             exec $scripts/screenshot.sh grim-save
bindsym $rl_lk Control+Mod1+Print           exec $scripts/screenshot.sh window-save

# ==================================================================================================== #
# =========== 10. MODES ============================================================================== #
# ==================================================================================================== #

set $shot exec swaymsg 'mode "default"' && $scripts/screenshot.sh

bindsym $mod+Print mode PRINT
mode PRINT {
    bindsym $tc print             $shot region
    bindsym $tc Shift+print       $shot fullscreen
    bindsym $rl_lk Mod1+print     $shot window

    bindsym Escape                mode "default"
    bindsym Return                mode "default"
    bindsym $mod+Print            mode "default"
}

set $msg_sys notify-send -t 1500 -h string:x-canonical-private-synchronous:sys

bindsym $mod+Escape mode SUPER
mode SUPER {
    bindsym $tc l                 exec $scripts/lock-ns.sh, mode default
    bindsym $tc s                 exec "swaylock -f && $scripts/sentry.sh", mode default
    bindsym $tc e                 exec $scripts/powermenu.sh logout, mode default
    bindsym $tc r                 exec $scripts/powermenu.sh reboot, mode default
    bindsym $tc p                 exec $scripts/powermenu.sh poweroff, mode default

    bindsym $tc t                 exec $term watch -n 3 -d sensors, mode default
    bindsym $tc n                 exec $scripts/wlsunset.sh, mode default
    bindsym $tc v                 exec pavucontrol, mode default

    bindsym $tc w                 exec nmcli radio wifi on && $msg_sys "Network: ON", mode default
    bindsym $tc Shift+w           exec nmcli radio wifi off && $msg_sys "Network: OFF", mode default
    bindsym $tc Control+w         exec $float_term nmtui, mode default

    bindsym $tc b                 exec bluetoothctl power on && $msg_sys "Bluetooth: ON", mode default
    bindsym $tc Shift+b           exec bluetoothctl power off && $msg_sys "Bluetooth: OFF", mode default
    bindsym $tc Control+b         exec $float_term bluetuith, mode default

    bindsym Escape                mode default
    bindsym Return                mode default
    bindsym $mod+Escape           mode default
}

set $msg_asus notify-send -t 1500 -h string:x-canonical-private-synchronous:asus

bindsym XF86Launch1 mode POWER
bindsym $tc $mod+p mode POWER
mode POWER {
    bindsym $tc s                 exec powerprofilesctl set power-saver && $msg_asus "Profile: Power Saver", mode "default"
    bindsym $tc b                 exec powerprofilesctl set balanced && $msg_asus "Profile: Balanced", mode "default"
    bindsym $tc p                 exec powerprofilesctl set performance && $msg_asus "Profile: Performance", mode "default"
    bindsym $tc l                 exec asusctl battery limit 60 && $msg_asus "Battery: Limit set to 60%", mode default
    bindsym $tc f                 exec asusctl battery oneshot && $msg_asus "Battery: Charging to 100%", mode default

    bindsym Escape                mode "default"
    bindsym Return                mode "default"
    bindsym XF86Launch1           mode "default"
    bindsym $tc $mod+p            mode "default"
}

bindsym $tc $mod+m mode MONITOR
mode MONITOR {
    bindsym $tc h                 focus output left
    bindsym $tc l                 focus output right
    bindsym $tc Shift+h           move container to output left
    bindsym $tc Shift+l           move container to output right
    bindsym $tc Control+h         move workspace to output left
    bindsym $tc Control+l         move workspace to output right

    bindsym Escape                mode default
    bindsym Return                mode default
    bindsym $tc $mod+m            mode default
}

bindsym $tc $mod+z mode ZIP
mode ZIP {
    bindsym 1                     move container to workspace number 1; workspace number 1
    bindsym 2                     move container to workspace number 2; workspace number 2
    bindsym 3                     move container to workspace number 3; workspace number 3
    bindsym 4                     move container to workspace number 4; workspace number 4
    bindsym 5                     move container to workspace number 5; workspace number 5
    bindsym 6                     move container to workspace number 6; workspace number 6
    bindsym 7                     move container to workspace number 7; workspace number 7
    bindsym 8                     move container to workspace number 8; workspace number 8
    bindsym 9                     move container to workspace number 9; workspace number 9

    bindsym Escape                mode default
    bindsym Return                mode default
    bindsym $tc $mod+z            mode default
}
