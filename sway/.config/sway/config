# ==============================================================================
#  SWAY CONFIGURATION
# ==============================================================================

# ==============================================================================
#  1. VARIABLES & PATHS
# ==============================================================================

include /etc/sway/config.d/*
exec dbus-update-activation-environment --systemd QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM ELECTRON_OZONE_PLATFORM_HINT ELECTRON_ENABLE_FEATURES MOZ_ENABLE_WAYLAND _JAVA_AWT_WM_NONREPARENTING LIBVA_DRIVER_NAME VDPAU_DRIVER AMD_VULKAN_ICD

set $mod Mod4
set $term kitty
set $f_term $term --title=float-term
set $menu fuzzel
set $scripts ~/.config/sway/scripts

# Organized Keycodes
set $q 24
set $w 25
set $e 26
set $r 27
set $t 28
set $y 29
set $u 30
set $i 31
set $o 32
set $p 33
set $a 38
set $s 39
set $d 40
set $f 41
set $g 42
set $h 43
set $j 44
set $k 45
set $l 46
set $z 52
set $x 53
set $c 54
set $v 55
set $b 56
set $n 57
set $m 58
set $semicolon 47
set $apostrophe 48
set $grave 49
set $comma 59
set $period 60
set $slash 61

set $left 43
set $down 44
set $up 45
set $right 46
set $l_mode 46

set $files      exec $term -e yazi
set $g_files    pcmanfm

# ==============================================================================
#  2. HARDWARE: INPUT & OUTPUT
# ==============================================================================

output * bg ~/Pictures/arch-loops.jpg fill

input type:keyboard {
    xkb_layout "us,ara"
    xkb_capslock disabled
    xkb_options "grp:alt_shift_toggle"
    repeat_delay 190
    repeat_rate 60
}

input type:touchpad {
    accel_profile adaptive
    pointer_accel 0.4
    scroll_factor 0.8
    dwt enabled
    tap enabled
    tap_button_map lrm
    drag_lock disabled
}

bindgesture swipe:3:left workspace prev
bindgesture swipe:3:right workspace next

exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors-r3'
    gsettings set org.gnome.desktop.interface cursor-size 24
    dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE
}

seat * xcursor_theme capitaine-cursors-r3 24
seat * hide_cursor when-typing enable
mouse_warping output

# ==============================================================================
#  3. AUTOSTART
# ==============================================================================

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec input-remapper-control --command autoload
exec swaync
exec easyeffects --hide-window
exec gammastep -l 31.11167:30.94583

exec nm-applet --indicator
exec sleep 1 && blueman-applet
exec_always "pkill -x waybar; sleep 0.5; waybar"

exec copyq --start-server
exec $scripts/idle-mgr.sh
exec flameshot
exec sh -c 'sleep 1 && firefox'

exec wpctl set-volume @DEFAULT_SINK@ 0.30
exec wpctl set-volume @DEFAULT_SOURCE@ 0.40
exec amixer -c 1 set 'Internal Mic Boost' 0

# ==============================================================================
#  4. APPEARANCE & THEME
# ==============================================================================

xwayland enable
default_border pixel 4
default_floating_border normal 4
hide_edge_borders smart
gaps inner 8
smart_gaps on

font pango:JetBrains Mono 11
titlebar_border_thickness 0
titlebar_padding 4 2
title_align center

# Syntax:                border     bg         text       indicator  child_border
client.focused           #60686e    #60686e    #ffffff    #aaaaaa    #60686e
client.focused_inactive  #3f4447    #2b2e30    #cccccc    #45494d    #17181a
client.unfocused         #17181a    #17181a    #8a8f93    #17181a    #17181a  
client.urgent            #232527    #232527    #ffffff    #d93a49    #d93a49
# ==============================================================================
#  5. WINDOW RULES
# ==============================================================================

# Specific Apps
for_window [app_id="fdm"] floating enable, resize set 1100 800, move position center, move scratchpad
for_window [app_id="org.qbittorrent.qBittorrent"] floating enable, resize set 1300 900, move position center
for_window [class="com-abdownloadmanager-desktop-AppKt"] floating enable
for_window [app_id="FileRoller"] floating enable
for_window [app_id="org.strawberrymusicplayer.strawberry"] floating enable
for_window [app_id="com.github.hluk.copyq"] floating enable, resize set 1800 1100, move position center
for_window [app_id="mpv"] floating enable
for_window [app_id="swayimg"] floating enable

# System / Portals / Dialogs
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, sticky enable
for_window [instance="sun-awt-X11-XDialogPeer"] floating enable
for_window [window_role="pop-up|bubble|task_dialog|dialog|menu"] floating enable
for_window [app_id="pavucontrol|nm-connection-editor|blueman-manager|blueman-services|syncthingtray"] floating enable, sticky enable

for_window [title="float-term"] floating enable, resize set 1100 800, move position center, title_format ""
for_window [title="Picture-in-Picture"] floating enable, sticky enable
for_window [app_id="firefox" title="^Extension:.*"] floating enable

# ==============================================================================
#  6. KEYBINDINGS: CORE
# ==============================================================================

bindsym $mod+Return         exec $term
bindsym $mod+Shift+Return   exec $f_term
bindsym $mod+space          exec $menu

bindcode $mod+$y            exec $files
bindcode $mod+Shift+$y      exec $f_term -e yazi
bindcode $mod+$g            exec $g_files
bindcode $mod+$b            exec $term -e btop
bindcode $mod+Shift+$b      exec $f_term -e btop

bindcode $mod+$q            kill
bindcode $mod+$x            exec $scripts/fuzzel-kill.sh TERM
bindcode $mod+Shift+$x      exec $scripts/fuzzel-kill.sh KILL
bindcode $mod+Shift+$r      reload

# ==============================================================================
#  7. NAVIGATION & LAYOUT
# ==============================================================================

bindsym  $mod+tab           focus mode_toggle
bindcode $mod+$left         focus left
bindcode $mod+$down         focus down
bindcode $mod+$up           focus up
bindcode $mod+$right        focus right

bindcode $mod+Shift+$left   move left
bindcode $mod+Shift+$down   move down
bindcode $mod+Shift+$up     move up
bindcode $mod+Shift+$right  move right

bindcode $mod+Shift+$period move workspace to output next
bindcode $mod+Shift+$comma  move workspace to output prev
bindcode $mod+$grave        workspace back_and_forth

bindcode $mod+$w layout tabbed
bindcode $mod+$e layout toggle split
bindcode $mod+$z layout stacking

bindcode $mod+$semicolon    split v
bindcode $mod+$apostrophe   split h

bindcode $mod+Shift+$f      floating toggle
bindcode $mod+$f            fullscreen
floating_modifier $mod normal

bindcode $mod+$s          scratchpad show     
bindcode $mod+Shift+$s          move scratchpad 

bindcode Control+$mod+$left  resize shrink width 40px
bindcode Control+$mod+$down  resize grow height 40px
bindcode Control+$mod+$up    resize shrink height 40px
bindcode Control+$mod+$right resize grow width 40px

# ==============================================================================
#  8. WORKSPACES
# ==============================================================================

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# ==============================================================================
#  9. UTILITIES
# ==============================================================================

# Volume & Brightness
bindsym --locked XF86AudioRaiseVolume  exec $scripts/vol.sh up
bindsym --locked XF86AudioLowerVolume  exec $scripts/vol.sh down
bindsym --locked XF86AudioMute         exec $scripts/vol.sh mute
bindcode --locked $mod+$u              exec $scripts/vol.sh up
bindcode --locked $mod+$d              exec $scripts/vol.sh down
bindcode --locked $mod+$m              exec $scripts/vol.sh mute

bindsym --locked XF86MonBrightnessUp   exec $scripts/bright.sh up
bindsym --locked XF86MonBrightnessDown exec $scripts/bright.sh down
bindcode --locked $mod+Shift+$u        exec $scripts/bright.sh up
bindcode --locked $mod+Shift+$d        exec $scripts/bright.sh down

# Media Control
bindsym  XF86AudioPrev  exec playerctl previous
bindsym  mod4+F6        exec playerctl previous
bindcode $mod+$p        exec playerctl previous

bindsym  XF86AudioPlay  exec $scripts/media.sh play-pause
bindsym  mod4+F7        exec $scripts/media.sh play-pause
bindcode $mod+$c        exec $scripts/media.sh play-pause

bindsym  XF86AudioNext  exec playerctl next
bindsym  mod4+F8        exec playerctl next
bindcode $mod+$n        exec playerctl next

bindcode $mod+Shift+$n  exec swaync-client -t -sw
bindcode $mod+Shift+$c  exec swaync-client --close-latest

bindcode $mod+$i        exec $scripts/idle-mgr.sh
bindcode $mod+$o        exec $scripts/idle-off.sh
bindcode $mod+$v        exec copyq toggle

bindcode Control+Shift+$s exec --no-startup-id flameshot gui -c
bindcode Control+mod1+$s  exec --no-startup-id flameshot gui -p ~/Pictures/Screenshots
bindsym  Print            exec --no-startup-id flameshot full -c && notify-send -t 1000 "Screenshot copied"
bindsym  Shift+Print      exec --no-startup-id flameshot full -p ~/Pictures/Screenshots && notify-send -t 1000 "Screenshot saved"

# ==============================================================================
# 10. MODES
# ==============================================================================

bindsym $mod+Escape mode Super
mode Super {

    bindcode $l_mode exec $scripts/lock-ns.sh, mode default
    bindcode $s exec "swaylock -f -c 000000 -F -e -k -L && systemctl suspend", mode default
    
    bindcode $e exec $scripts/powermenu.sh logout, mode default
    bindcode $r exec $scripts/powermenu.sh reboot, mode default
    bindcode $p exec $scripts/powermenu.sh poweroff, mode default

    bindcode $t exec $term -e watch -n 2.5 -d sensors, mode default
    bindcode $g exec $scripts/toggle_gammastep.sh, mode default
    bindcode $u exec $term -e sh -c 'sudo pacman -Syu && yay -Syua; read -p "Press enter to exit..."', mode default
    bindcode $a exec $term -e sh -c 'alsamixer', mode default
    bindcode $v exec pavucontrol, mode default

    bindsym Escape mode default
    bindsym Return mode default
    bindcode $mod+Escape mode default
}

bindsym XF86Launch1 mode Asus
bindcode $mod+$a mode Asus
mode Asus {
    bindsym 1 exec powerprofilesctl set power-saver \
        && notify-send -t 1000 -h string:x-canonical-private-synchronous:asus " Profile: power-saver", mode "default"
    
    bindsym 2 exec powerprofilesctl set balanced \
        && notify-send -t 1000 -h string:x-canonical-private-synchronous:asus " Profile: Balanced", mode "default"
    
    bindsym 3 exec powerprofilesctl set performance \
        && notify-send -t 1000 -h string:x-canonical-private-synchronous:asus " Profile: Performance", mode "default"

    bindsym semicolon exec asusctl battery limit 60 \
        && notify-send -t 1000 -h string:x-canonical-private-synchronous:asus " Battery: Limit set to 60%", mode default

    bindsym apostrophe exec asusctl battery oneshot \
        && notify-send -t 1000 -h string:x-canonical-private-synchronous:asus " Battery: Charging to 100%", mode default

    bindsym Escape mode "default"
    bindsym Return mode "default"
    bindsym XF86Launch1 mode "default"
    bindcode $mod+$a mode "default"
}
