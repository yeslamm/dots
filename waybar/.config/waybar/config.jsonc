{
    // "ipc": true,
    // "layer": "top",
    // "mode": "hide",
    // "start_hidden": true,
    // "exclusive": false,
    // "modifier-reset": "press",
    // "fixed-height": true,
    // "spacing": 4,
    // "modes": {
    //     "invisible": {
    //         "layer": "bottom",
    //         "passthrough": true
    //     }
    // },
    "height": 28,
    "position": "top",
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "custom/separator0",
        "memory",
        "custom/separator0",
        "cpu",
        "custom/separator0",
        "temperature",
        "custom/separator0",
        "custom/swayidle"
    ],
    "modules-right": [
        "tray",
        "custom/separator1",
        "custom/asus",
        "custom/separator1",
        "pulseaudio",
        "custom/separator1",
        "backlight",
        "custom/separator1",
        "sway/language",
        "custom/separator1",
        "battery"
    ],
    "modules-center": ["clock"],

    "custom/separator0": {
        "format": " / ",
        "tooltip": false
    },

    "custom/separator1": {
        "format": " \\ ",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 16
    },
    // "pulseaudio": {
    //     "format": "VOL: {volume}%",
    //     "format-muted": "vol: Muted",
    //     "on-scroll-up": "pamixer --increase 1",
    //     "on-scroll-down": "pamixer --decrease 1",
    //     "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    //     "on-click-right": "playerctl play-pause",
    //     "on-click-middle": "pavucontrol"
    // },
    // "backlight": {
    //     "device": "amdgpu_bl1",
    //     "format": "BRIGHT: {percent}%",
    //     "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +1%",
    //     "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 1%-",
    //     "on-click": "brightnessctl -d amdgpu_bl1 set 85%",
    //     "on-click-right": "brightnessctl -d amdgpu_bl1 set 70%",
    //     "on-click-middle": "brightnessctl -d amdgpu_bl1 set 50%",
    //     "tooltip": false
    // },
    "pulseaudio": {
        "format": "VOL: {volume}%",
        "format-muted": "vol: Muted",
        // Signal 10 for Volume
        "signal": 10,
        "on-scroll-up": "pamixer --increase 1 && pkill -RTMIN+10 waybar",
        "on-scroll-down": "pamixer --decrease 1 && pkill -RTMIN+10 waybar",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle && pkill -RTMIN+10 waybar",
        "on-click-right": "playerctl play-pause",
        "on-click-middle": "pavucontrol"
    },
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "BRIGHT: {percent}%",
        // Signal 11 for Brightness
        "signal": 11,
        "on-scroll-up": "brightnessctl -d amdgpu_bl1 set +1% && pkill -RTMIN+11 waybar",
        "on-scroll-down": "brightnessctl -d amdgpu_bl1 set 1%- && pkill -RTMIN+11 waybar",
        "on-click": "brightnessctl -d amdgpu_bl1 set 85% && pkill -RTMIN+11 waybar",
        "on-click-right": "brightnessctl -d amdgpu_bl1 set 70% && pkill -RTMIN+11 waybar",
        "on-click-middle": "brightnessctl -d amdgpu_bl1 set 50% && pkill -RTMIN+11 waybar",
        "tooltip": false
    },
    "clock": {
        "interval": 60,
        "tooltip": true,
        "format": "{:%d/%m - %I:%M %p}",
        "tooltip-format": "{:%A %d of %B}",
        "max-length": 25
    },
    "battery": {
        "interval": 1,
        "states": {
            "clamped": 70
        },
        "format": "BATT: {capacity}%",
        "format-charging": "BATT: + {capacity}%",
        "format-discharging": "BATT: - {capacity}%",
        "format-full": "BATT: {capacity}%",
        "format-clamped": "BATT: {capacity}%"
    },
    "memory": {
        "interval": 3,
        "format": "MEM: {used:0.2f}G",
        "on-click": "kitty -e btop",
        "tooltip": false
    },
    "temperature": {
        "interval": 3,
        "tooltip": false,
        "thermal-zone": 0,
        "format": "TEMP: {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": "temp: CRIT {temperatureC}°C",
        "on-click": "kitty -e watch -d sensors"
    },
    "cpu": {
        "interval": 3,
        "format": "CPU: {}%",
        "on-click": "gnome-system-monitor"
    },
    "network": {
        "interface": "wlan0",
        "format": "{bandwidthUpBits} ",
        "interval": 3,
        "tooltip-format": "{ifname}",
        "tooltip": false,
        "tooltip-format-ethernet": "{ifname}",
        "format-disconnected": " Offline  ",
        "on-click": "nmgui"
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 50,
        "tooltip": true
    },
    "sway/language": {
        "format": "LANG: {short} {variant}",
        "tooltip": false
    },

    "disk": {
        "path": "/home",
        "interval": 30,
        "format": "HOME: {percentage_used}%",
        "on-click": "gnome-disks"
    },
    "custom/asus": {
        "format": "{}",
        "exec": "asusctl profile get | grep -oP '(Quiet|Balanced|Performance)' | head -n 1",
        "signal": 8,
        "on-click": "asusctl profile next && pkill -RTMIN+8 waybar",
        "tooltip": true
    },
    "sway/mode": {
        "format": "{}"
    },
    "custom/swayidle": {
        "exec": "~/.config/waybar/idle_status.sh",
        "interval": "once",
        "signal": 9,
        "return-type": "json",
        "format": "{text}",
        "tooltip": true
    }
}
