{
  // ==============================================================================
  // GLOBAL BAR LAYOUT
  // ==============================================================================
  "position": "top",
  "output": "eDP-1",

  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "sway/mode",
    "memory",
    "cpu",
    "temperature",
    "custom/fan",
    "custom/idlemgr"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "tray",
    "custom/capslock",
    "sway/language",
    "bluetooth",
    "network",
    "wireplumber",
    "backlight",
    "battery",
    "power-profiles-daemon"
  ],

  // ==============================================================================
  // SWAY / WINDOW MANAGER MODULES
  // ==============================================================================
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },

  "sway/scratchpad": {
    "format": "[] {count}",
    "show-empty": false
  },

  "sway/mode": {
    "format": "{}"
  },

  "sway/language": {
    "format": "{shortDescription}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": true,
    "tooltip-format": "{long} {variant}"
  },

  // ==============================================================================
  // SYSTEM HARDWARE MONITORS
  // ==============================================================================
  "memory": {
    "interval": 3,
    "format": "{used:0.2f}G",
    "on-click": "$TERMINAL btop",
    "tooltip": true,
    "tooltip-format": "Used: {used:0.2f}G\nSwap: {swapUsed:0.2f}G\nTotal: {total:0.2f}G"
  },

  "cpu": {
    "interval": 3,
    "format": "{usage}%",
    "on-click": "missioncenter"
  },

  "temperature": {
    "interval": 3,
    "tooltip": false,
    "format": "{temperatureC}°C",
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 100,
    "format-critical": "CRIT {temperatureC}°C",
    "on-click": "$TERMINAL watch -d sensors"
  },

  "custom/fan": {
    "exec": "~/.config/waybar/fan.sh",
    "interval": 3,
    "tooltip": false,
    "format": "{}",
    "on-click": "$TERMINAL watch -d sensors"
  },

  // ==============================================================================
  // DATE & TIME (CENTER)
  // ==============================================================================
  "clock": {
    "format": "{:%d/%m - %R}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 4,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#be95ff'><b>{}</b></span>",
        "days": "<span color='#dfdfe0'><b>{}</b></span>",
        "weeks": "<span color='#6f6f6f'><b>W{}</b></span>",
        "weekdays": "<span color='#25be6a'><b>{}</b></span>",
        "today": "<span color='#78a9ff'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-middle": "mode",
      "on-click": "shift_up",
      "on-click-right": "shift_down"
    }
  },

  // ==============================================================================
  // HARDWARE TOGGLES & CONNECTIVITY
  // ==============================================================================
  "bluetooth": {
    "format": "ON",
    "format-connected": "{num_connections} CON",
    "format-off": "OFF",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\n{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\nt{device_address}",
    "on-click": "$TERMINAL --app-id=fterm bluetuith"
  },

  "network": {
    "format-wifi": "ON",
    "format-ethernet": "ETH",
    "format-disconnected": "OFF",
    "format-disabled": "OFFLINE",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "SSID: {essid}\nIP: {ipaddr}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Network Disconnected",
    "tooltip-format-disabled": "Networking Powered Off",
    "on-click": "$TERMINAL --app-id=fterm nmtui-go"
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/sway/scripts/media.sh",
    "on-click-middle": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "scroll-step": 5,
    "on-click": "brightnessctl set 85%",
    "on-click-right": "brightnessctl set 70%",
    "on-click-middle": "brightnessctl set 50%",
    "tooltip": false
  },

  // ==============================================================================
  // SYSTEM STATUS & PRIVACY
  // ==============================================================================
  "battery": {
    "bat": "BAT1",
    "interval": 30,
    "states": {
      "clamped": 60,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "+ {capacity}%",
    "format-discharging": "- {capacity}%",
    "format-full": "{capacity}%",
    "format-clamped": "{capacity}%"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "P",
      "balanced": "B",
      "power-saver": "S"
    }
  },

  "privacy": {
    "icon-spacing": 10,
    "icon-size": 16,
    "transition-duration": 0,
    "modules": [
      { "type": "screenshare", "icon-name": "screen-shared-symbolic" },
      { "type": "audio-in", "icon-name": "audio-input-microphone-symbolic" }
    ]
  },

  "custom/idlemgr": {
    "exec": "[ -f \"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/IDLE_ENABLED\" ] && echo '' || echo 'INHIBIT'",
    "return-type": "text",
    "interval": "once",
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/idlemgr.sh TOGGLE"
  },

  "custom/capslock": {
    "exec": "stdbuf -oL ~/.config/waybar/capslock.sh",
    "format": "{}",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 12
  }
}
