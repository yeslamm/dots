{
  "position": "top",
  "output": "eDP-1",
  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "sway/mode",
    "memory",
    "cpu",
    "temperature",
    "custom/fan",
    "custom/idlemgr"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "tray",
    "custom/capslock",
    "sway/language",
    "bluetooth",
    "network",
    "wireplumber",
    "backlight",
    "battery",
    "power-profiles-daemon"
  ],

  // ==========================================
  // MODULES-LEFT CONFIGURATION
  // ==========================================

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}"
  },

  "sway/scratchpad": {
    "format": "[{count}]",
    "show-empty": false
  },

  "sway/mode": {
    "format": "{}"
  },

  "memory": {
    "interval": 3,
    "format": "{used:0.2f}G",
    "on-click": "$TERMINAL btop",
    "tooltip": true,
    "tooltip-format": "Used: {used:0.2f}G\nSwap: {swapUsed:0.2f}G\nTotal: {total:0.2f}G"
  },

  "cpu": {
    "interval": 3,
    "format": "{}%",
    "on-click": "missioncenter"
  },

  "temperature": {
    "interval": 3,
    "tooltip": false,
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "format": "{temperatureC}°C",
    "critical-threshold": 100,
    "format-critical": "CRIT {temperatureC}°C",
    "on-click": "$TERMINAL watch -d sensors"
  },

  "custom/fan": {
    "exec": "~/.config/waybar/fan.sh",
    "interval": 3,
    "tooltip": false,
    "on-click": "$TERMINAL watch -d sensors"
  },

  "custom/idlemgr": {
    "exec": "pgrep swayidle > /dev/null && echo '' || echo 'INHIBIT_IDLE'",
    "return-type": "text",
    "interval": "once",
    "signal": 12,
    "tooltip": false,
    "on-click": "~/.config/sway/scripts/idlemgr.sh TOGGLE"
  },

  // ==========================================
  // MODULES-CENTER CONFIGURATION
  // ==========================================

  "clock": {
    "format": "{:%d/%m - %R}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-middle": "mode",
      "on-click": "shift_up",
      "on-click-right": "shift_down"
    }
  },

  // ==========================================
  // MODULES-RIGHT CONFIGURATION
  // ==========================================

  "privacy": {
    "icon-spacing": 15,
    "icon-size": 16,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "icon-name": "screen-shared-symbolic"
      },
      {
        "type": "audio-in",
        "icon-name": "audio-input-microphone-symbolic"
      }
    ]
  },

  "tray": {
    "icon-size": 16,
    "spacing": 15
  },

  "custom/capslock": {
    "exec": "~/.config/waybar/capslock.sh",
    "format": "{}",
    "tooltip": false
  },

  "sway/language": {
    "format": "{shortDescription} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": true,
    "tooltip-format": "{long} {variant}"
  },

  "bluetooth": {
    "format": "ON",
    "format-connected": "{num_connections} CON",
    "format-off": "OFF",
    "format-disabled": "--",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-off": "Bluetooth is powered off",
    "tooltip-format-disabled": "Bluetooth hardware is disabled",
    "on-click": "bluetoothctl power on",
    "on-click-right": "bluetoothctl power off",
    "on-click-middle": "$TERMINAL bluetuith"
  },

  "network": {
    "format-wifi": "ON",
    "format-ethernet": "ETH",
    "format-disconnected": "OFF",
    "format-disabled": "--",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nFreq: {frequency}Ghz\n\nIP: {ipaddr}\nGW: {gwaddr}",
    "tooltip-format-ethernet": "{ifname}\t{ipaddr}",
    "tooltip-format-disconnected": "No active network connection",
    "tooltip-format-disabled": "Networking is completely disabled",
    "on-click": "nmcli radio wifi on",
    "on-click-right": "nmcli radio wifi off",
    "on-click-middle": "$TERMINAL nmtui"
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/sway/scripts/media.sh",
    "on-click-middle": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "scroll-step": 5,
    "on-click": "brightnessctl set 85%",
    "on-click-right": "brightnessctl set 70%",
    "on-click-middle": "brightnessctl set 50%",
    "tooltip": false
  },

  "battery": {
    "bat": "BAT1",
    "interval": 30,
    "states": {
      "clamped": 60,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "+ {capacity}%",
    "format-discharging": "- {capacity}%",
    "format-full": "{capacity}%",
    "format-clamped": "{capacity}%"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "|>",
      "balanced": "|=",
      "power-saver": "|-"
    }
  }
}
