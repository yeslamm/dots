{
  "height": 28,
  "position": "top",
  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "sway/mode",
    "custom/separator0",
    "memory",
    "custom/separator0",
    "cpu",
    "custom/separator0",
    "temperature",
    "custom/separator0",
    "custom/fan",
    "custom/separator0",
    "custom/idlemgr"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "tray",
    "custom/separator1",
    "power-profiles-daemon",
    "custom/separator1",
    "keyboard-state",
    "custom/separator1",
    "sway/language",
    "custom/separator1",
    "wireplumber",
    "custom/separator1",
    "backlight",
    "custom/separator1",
    "battery"
  ],

  "custom/separator0": {
    "format": "   ",
    "tooltip": false
  },

  "custom/separator1": {
    "format": "   ",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 16
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "Muted",
    // Using your custom scripts so you get the notify-send popups!
    "on-scroll-up": "~/.config/sway/scripts/vol.sh up",
    "on-scroll-down": "~/.config/sway/scripts/vol.sh down",
    "on-click": "~/.config/sway/scripts/vol.sh mute",
    // Using your media script for right click
    "on-click-right": "~/.config/sway/scripts/media.sh",
    "on-click-middle": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "on-scroll-up": "~/.config/sway/scripts/bright.sh up",
    "on-scroll-down": "~/.config/sway/scripts/bright.sh down",
    "on-click": "brightnessctl -d amdgpu_bl1 set 85%",
    "on-click-right": "brightnessctl -d amdgpu_bl1 set 70%",
    "on-click-middle": "brightnessctl -d amdgpu_bl1 set 50%",
    "tooltip": false
  },
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%d/%m - %I:%M %p}",
    "tooltip-format": "{:%A %d of %B}",
    "max-length": 25
  },
  "battery": {
    "bat": "BAT1",
    "interval": 1,
    "states": {
      "clamped": 70
    },
    "format": "{capacity}%",
    "format-charging": "+ {capacity}%",
    "format-discharging": "- {capacity}%",
    "format-full": "{capacity}%",
    "format-clamped": "{capacity}%"
  },
  "memory": {
    "interval": 3,
    "format": "{used:0.2f}G",
    "on-click": "$TERMINAL -e btop",
    "tooltip": false
  },
  "temperature": {
    "interval": 3,
    "tooltip": false,
    "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
    "format": "{temperatureC}°C",
    "critical-threshold": 100,
    "format-critical": "CRIT {temperatureC}°C",
    "on-click": "$TERMINAL -e watch -d sensors"
  },
  "cpu": {
    "interval": 3,
    "format": "{}%",
    "on-click": "missioncenter"
  },
  "sway/language": {
    "format": "{short} {variant}",
    "tooltip": false
  },
  "keyboard-state": {
    "numlock": false,
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "CAPS   ",
      "unlocked": ""
    }
  },
  "custom/fan": {
    "format": "{} RPM",
    "exec": "sensors | awk '/cpu_fan/ {print $2}'",
    "interval": 3,
    "tooltip": false,
    "on-click": "$TERMINAL -e watch -d sensors"
  },
  "power-profiles-daemon": {
    "format": "{profile}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true
  },
  "sway/mode": {
    "format": "{}"
  },
  "custom/idlemgr": {
    "exec": "pgrep swayidle > /dev/null && echo 'IDLE: on' || echo 'IDLE: off'",
    "return-type": "text",
    "interval": "once",
    "signal": 12,
    "tooltip": false
  },
  "privacy": {
    "icon-spacing": 18,
    "icon-size": 14,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "icon-name": "screen-shared-symbolic"
      },
      {
        "type": "audio-in",
        "icon-name": "audio-input-microphone-symbolic"
      }
    ]
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  }
}
