{
  "position": "top",
  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "sway/mode",
    "custom/separator",
    "memory",
    "custom/separator",
    "cpu",
    "custom/separator",
    "temperature",
    "custom/separator",
    "custom/fan",
    "custom/idlemgr"
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "privacy",
    "tray",
    "custom/separator",
    "keyboard-state",
    "sway/language",
    "custom/separator",
    "bluetooth",
    "custom/separator",
    "network",
    "custom/separator",
    "wireplumber",
    "custom/separator",
    "backlight",
    "custom/separator",
    "battery",
    "power-profiles-daemon"
  ],

  "custom/separator": {
    "format": " ",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 14
  },

  "wireplumber": {
    "format": "{volume}%",
    "format-muted": "Muted",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
    "on-click": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "~/.config/sway/scripts/media.sh",
    "on-click-middle": "pavucontrol"
  },

  "backlight": {
    "device": "amdgpu_bl1",
    "format": "{percent}%",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "on-click": "brightnessctl set 85%",
    "on-click-right": "brightnessctl set 70%",
    "on-click-middle": "brightnessctl set 50%",
    "tooltip": false
  },
  "clock": {
    "interval": 60,
    "tooltip": true,
    "format": "{:%d/%m - %I:%M %p}",
    "tooltip-format": "{:%A %d of %B}",
    "max-length": 25
  },
  "battery": {
    "bat": "BAT1",
    "interval": 30,
    "states": {
      "clamped": 60,
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}%",
    "format-charging": "+ {capacity}%",
    "format-discharging": "- {capacity}%",
    "format-full": "{capacity}%",
    "format-clamped": "{capacity}%"
  },
  "memory": {
    "interval": 3,
    "format": "{used:0.2f}G",
    "on-click": "$TERMINAL -e btop",
    "tooltip": true,
    "tooltip-format": "Used: {used:0.2f}G\nSwap: {swapUsed:0.2f}G\nTotal: {total:0.2f}G"
  },
  "temperature": {
    "interval": 3,
    "tooltip": false,
    "thermal-zone": "/sys/class/thermal/thermal_zone0",
    "format": "{temperatureC}°C",
    "critical-threshold": 100,
    "format-critical": "CRIT {temperatureC}°C",
    "on-click": "$TERMINAL -e watch -d sensors"
  },
  "cpu": {
    "interval": 3,
    "format": "{}%",
    "on-click": "missioncenter"
  },
  "sway/language": {
    "format": "{shortDescription} {variant}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
    "tooltip": true,
    "tooltip-format": "{long} {variant}"
  },
  "keyboard-state": {
    "numlock": false,
    "capslock": true,
    "format": "{icon}",
    "format-icons": {
      "locked": "CAPS  ",
      "unlocked": ""
    }
  },

  "custom/fan": {
    "exec": "awk '{if ($1 != 0) print $1 \" RPM  \"}' /sys/class/hwmon/hwmon7/fan1_input",
    "interval": 3,
    "tooltip": false,
    "on-click": "$TERMINAL -e watch -d sensors"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "|>",
      "balanced": "|=",
      "power-saver": "|-"
    }
  },
  "sway/mode": {
    "format": "{}"
  },
  "custom/idlemgr": {
    "exec": "pgrep swayidle > /dev/null && echo 'IDLE: ON' || echo 'IDLE: OFF'",
    "return-type": "text",
    "interval": "once",
    "signal": 12,
    "tooltip": false
  },
  "privacy": {
    "icon-spacing": 18,
    "icon-size": 14,
    "transition-duration": 0,
    "modules": [
      {
        "type": "screenshare",
        "icon-name": "screen-shared-symbolic"
      },
      {
        "type": "audio-in",
        "icon-name": "audio-input-microphone-symbolic"
      }
    ]
  },
  "sway/scratchpad": {
    "format": "███ {count}",
    "show-empty": false
  },
  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "{ipaddr}",
    "format-disconnected": "DISCONNECTED",
    "format-disabled": "OFF",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nFreq: {frequency}Ghz\n\nIP: {ipaddr}\nGW: {gwaddr}",
    "tooltip-format-ethernet": "{ifname}\t{ipaddr}",
    "tooltip-format-disconnected": "No active network connection",
    "tooltip-format-disabled": "Networking is completely disabled",
    "max-length": 18,
    "on-click": "nmcli radio all on",
    "on-click-right": "nmcli radio all off",
    "on-click-middle": "$TERMINAL -e nmtui"
  },
  "bluetooth": {
    "format": "ON",
    "format-connected": "{num_connections} CONNECTED",
    "format-off": "OFF",
    "format-disabled": "DISABLED",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-off": "Bluetooth is powered off",
    "tooltip-format-disabled": "Bluetooth hardware is disabled",
    "on-click": "bluetoothctl power on",
    "on-click-right": "bluetoothctl power off",
    "on-click-middle": "$TERMINAL -e bluetuith"
  }
}
