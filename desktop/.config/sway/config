# ============================================================================ #
# ============================ SWAY CONFIGURATION ============================ #
# ============================================================================ #

# ============================================================================ #
# == 1. VARIABLES & ENVIRONMENT ============================================== #
# ============================================================================ #

include /etc/sway/config.d/*

exec dbus-update-activation-environment --systemd XCURSOR_THEME XCURSOR_SIZE

set $mod         Mod4
set $term        foot
set $menu        fuzzel

set $scripts     ~/.config/sway/scripts

set $float_term  $term --app-id=fterm
set $clip_term   $term --app-id=clipfzf
set $pulse_term  $term --app-id=pulsemixer

set $msg_mic     notify-send -t 1500 -h string:x-canonical-private-synchronous:mic
set $msg_asus    notify-send -t 1500 -h string:x-canonical-private-synchronous:asus
set $msg_sys     notify-send -t 1500 -h string:x-canonical-private-synchronous:sys

set $tc          --to-code
set $lk          --locked
set $rl          --release
set $ww          --whole-window

# ============================================================================ #
# == 2. HARDWARE: INPUT & OUTPUT ============================================= #
# ============================================================================ #

output * bg #0f0f0f solid_color
output eDP-1 max_render_time 3

input type:keyboard {
    xkb_layout      "us,ara"
    xkb_options     grp:win_space_toggle
    repeat_delay    190
    repeat_rate     60
}

input type:touchpad {
    accel_profile   adaptive
    pointer_accel   0.4
    scroll_factor   0.8
    dwt             enabled
    tap             enabled
    tap_button_map  lrm
}

input type:pointer {
    accel_profile   flat
    pointer_accel   0.4
}

bindgesture swipe:3:right workspace next
bindgesture swipe:3:left  workspace prev

bindswitch $lk lid:on exec $scripts/lid-action.sh
seat * xcursor_theme capitaine-cursors-light 32
seat * hide_cursor when-typing disable
seat * fallback true
mouse_warping output

# ============================================================================ #
# == 3. APPEARANCE & THEME =================================================== #
# ============================================================================ #

default_border            pixel 1
default_floating_border   normal 1
floating_maximum_size     1850 x 1100
smart_borders             on
gaps inner                0
gaps outer                0

font pango:JetBrainsMono NF, Vazirmatn semi-bold 12
titlebar_padding 2 2
titlebar_border_thickness 1
title_align center

exec {
    gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors-light'
    gsettings set org.gnome.desktop.interface cursor-size 32
    gsettings set org.gnome.desktop.interface gtk-theme 'adw-gtk3-dark'
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
}

# class                   border   backgr.  text     indic.   child_border
client.focused            #78a9ff  #262626  #dfdfe0  #08bdba  #78a9ff
client.focused_tab_title  #262626  #262626  #dfdfe0
client.focused_inactive   #363636  #262626  #dfdfe0  #08bdba  #363636
client.unfocused          #363636  #161616  #6f6f6f  #161616  #363636
client.urgent             #ee5396  #262626  #ffffff  #ee5396  #ee5396

# ============================================================================ #
# == 4. WINDOW RULES ========================================================= #
# ============================================================================ #

for_window [app_id="fterm"] floating enable, resize set width 70 ppt height 75 ppt, move position center
for_window [app_id="clipfzf"] floating enable, resize set width 85 ppt height 85 ppt, move position center
for_window [app_id="pulsemixer"] floating enable, resize set width 70 ppt height 70 ppt, move position center, move scratchpad, scratchpad show

for_window [app_id="(?i)FileRoller|gpu_screen_recorder|xdg-desktop-portal-gtk|pavucontrol"] floating enable

for_window [window_role="^(pop-up|bubble|task_dialog|dialog|menu)$"] floating enable

for_window [window_type="dialog"] floating enable
for_window [window_type="utility"] floating enable
for_window [window_type="toolbar"] floating enable
for_window [window_type="splash"] floating enable

for_window [instance="sun-awt-X11-XDialogPeer"] floating enable

for_window [title="(?i)picture-in-picture|picture in picture"] floating enable, sticky enable
for_window [app_id="firefox" title="^Extension:"] floating enable

for_window [app_id="mpv|swayimg"] fullscreen enable

for_window [all] inhibit_idle fullscreen

for_window [app_id="(?i)mpv|zathura|qbittorrent|steam|gamescope|\.exe"] inhibit_idle focus
for_window [class="(?i)mpv|zathura|qbittorrent|steam|gamescope|\.exe"] inhibit_idle focus

# ============================================================================ #
# == 5. KEYBINDINGS: CORE ==================================================== #
# ============================================================================ #

bindsym $mod+Return                 exec $term
bindsym $mod+Shift+Return           exec $float_term
bindsym $tc $mod+d                  exec $menu

bindsym $tc $mod+y                  exec $term yazi
bindsym $tc $mod+Shift+y            exec $float_term yazi
bindsym $tc $mod+b                  exec $term btop
bindsym $tc $mod+Shift+b            exec $float_term btop

bindsym $tc $mod+q                  kill
bindsym $ww $mod+button2            kill
bindsym $tc $mod+Shift+r            reload

# ============================================================================ #
# == 6. NAVIGATION & LAYOUT ================================================== #
# ============================================================================ #

floating_modifier $mod normal

bindsym $tc $mod+h                  focus left
bindsym $tc $mod+j                  focus down
bindsym $tc $mod+k                  focus up
bindsym $tc $mod+l                  focus right

bindsym $tc $mod+Shift+h            move left  40 px
bindsym $tc $mod+Shift+j            move down  40 px
bindsym $tc $mod+Shift+k            move up    40 px
bindsym $tc $mod+Shift+l            move right 40 px

bindsym $tc Control+$mod+h          resize shrink width  40 px
bindsym $tc Control+$mod+j          resize grow   height 40 px
bindsym $tc Control+$mod+k          resize shrink height 40 px
bindsym $tc Control+$mod+l          resize grow   width  40 px

bindsym $tc $mod+w                  layout tabbed
bindsym $tc $mod+Shift+w            layout toggle split
bindsym $tc $mod+apostrophe         split h
bindsym $tc $mod+semicolon          split v
bindsym $tc $mod+Shift+apostrophe   split none
bindsym $tc $mod+Shift+semicolon    split none

bindsym $tc $mod+f                  fullscreen
bindsym $tc $mod+Shift+f            floating toggle
bindsym $tc $mod+Shift+c            move position center
bindsym $tc $mod+a                  focus parent
bindsym $tc $mod+c                  focus child

bindsym $tc $mod+grave              workspace back_and_forth
bindsym $tc $mod+Shift+grave        move container to workspace back_and_forth; workspace back_and_forth

bindsym $mod+tab                    focus mode_toggle

bindsym $tc $mod+s                  scratchpad show
bindsym $tc $mod+Shift+s            move scratchpad

# ============================================================================ #
# == 7. WORKSPACES =========================================================== #
# ============================================================================ #

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ============================================================================ #
# == 8. UTILITIES & HARDWARE ================================================= #
# ============================================================================ #

bindsym $lk XF86AudioRaiseVolume            exec osd volume up
bindsym $lk XF86AudioLowerVolume            exec osd volume down
bindsym $lk XF86AudioMute                   exec osd volume mute
bindsym $lk XF86AudioMicMute                exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $msg_mic "Microphone: $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo 'Muted' || echo 'Unmuted')"
bindsym $lk XF86AudioPlay                   exec media play-pause
bindsym $lk XF86AudioNext                   exec playerctl next
bindsym $lk XF86AudioPrev                   exec playerctl previous

bindsym $lk $mod+equal                      exec osd volume up
bindsym $lk $mod+minus                      exec osd volume down
bindsym $lk $mod+0                          exec osd volume mute
bindsym $lk $mod+Shift+0                    exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle && $msg_mic "Microphone: $(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED && echo 'Muted' || echo 'Unmuted')"

bindsym $lk $mod+Shift+period               exec playerctl position 5+
bindsym $lk $mod+Shift+comma                exec playerctl position 5-
bindsym $lk $mod+Shift+slash                exec playerctl position 0
bindsym $tc $lk $mod+period                 exec playerctl next
bindsym $tc $lk $mod+comma                  exec playerctl previous
bindsym $tc $lk $mod+Control+comma          exec playerctld shift
bindsym $tc $lk $mod+Control+period         exec playerctld unshift
bindsym $tc $lk $mod+slash                  exec media play-pause

bindsym $lk XF86MonBrightnessUp             exec osd brightness up
bindsym $lk XF86MonBrightnessDown           exec osd brightness down
bindsym $tc $lk $mod+bracketright           exec osd brightness up
bindsym $tc $lk $mod+bracketleft            exec osd brightness down

bindsym $tc $mod+n                          exec makoctl dismiss
bindsym $tc $mod+Shift+n                    exec makoctl invoke
bindsym $tc $mod+i                          exec $scripts/idle-mgr.sh toggle

bindsym $tc $mod+v                          exec swaymsg '[app_id="clipfzf"] kill' || $clip_term clipfzf

bindsym $rl Print                           exec screenshot region-copy
bindsym $rl Shift+Print                     exec screenshot fullscreen-copy
bindsym $rl Control+Print                   exec screenshot window-copy

bindsym $rl $mod+Print                      exec screenshot region
bindsym $rl $mod+Shift+Print                exec screenshot fullscreen
bindsym $rl $mod+Control+Print              exec screenshot window

bindsym $rl $mod+F12                        exec screenrec region
bindsym $rl $mod+Shift+F12                  exec screenrec fullscreen
bindsym $rl $mod+Control+F12                exec screenrec window

# ============================================================================ #
# == 9. AUTOSTART ============================================================ #
# ============================================================================ #

exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec keyd-application-mapper -d
exec playerctld daemon

exec bluelight on
exec wayland-pipewire-idle-inhibit -d 10 -q

exec wl-paste --type text --watch cliphist -db-path "$XDG_RUNTIME_DIR/cliphist.db" store
exec wl-paste --type image --watch cliphist -db-path "$XDG_RUNTIME_DIR/cliphist.db" store

exec $scripts/power-watcher.sh
exec $scripts/idle-mgr.sh on
exec mako

exec_always $scripts/start-wob.sh
exec_always pkill -x -USR2 waybar || (sleep 0.2 && waybar)

exec sh -c 'exec aria2c --conf-path="$HOME/.config/aria2/aria2-rpc.conf" --rpc-secret="$(cat "$HOME/.config/aria2/secret.key")"'

# ============================================================================ #
# == 10. MODES =============================================================== #
# ============================================================================ #

bindsym $tc $mod+r mode "RESIZE"
mode "RESIZE" {
    bindsym tab                    focus mode_toggle
    bindsym $tc a                  focus parent
    bindsym $tc c                  focus child
    bindsym $tc Shift+c            move position center

    bindsym $tc Control+h          resize shrink width  5 px
    bindsym $tc Control+j          resize grow   height 5 px
    bindsym $tc Control+k          resize shrink height 5 px
    bindsym $tc Control+l          resize grow   width  5 px

    bindsym $tc h                  resize shrink width  20 px
    bindsym $tc j                  resize grow   height 20 px
    bindsym $tc k                  resize shrink height 20 px
    bindsym $tc l                  resize grow   width  20 px

    bindsym $tc Shift+h            resize shrink width  50 px
    bindsym $tc Shift+j            resize grow   height 50 px
    bindsym $tc Shift+k            resize shrink height 50 px
    bindsym $tc Shift+l            resize grow   width  50 px

    bindsym $tc Control+Shift+h    resize shrink width  150 px
    bindsym $tc Control+Shift+j    resize grow   height 150 px
    bindsym $tc Control+Shift+k    resize shrink height 150 px
    bindsym $tc Control+Shift+l    resize grow   width  150 px

    bindsym Escape                 mode "default"
    bindsym Return                 mode "default"
    bindsym $tc q                  mode "default"
    bindsym $tc $mod+r             mode "default"
}

bindsym $tc $mod+m mode "MOVE"
mode "MOVE" {
    bindsym tab                    focus mode_toggle
    bindsym $tc a                  focus parent
    bindsym $tc c                  focus child
    bindsym $tc Shift+c            move position center

    bindsym 1                      move container to workspace number 1; workspace number 1
    bindsym 2                      move container to workspace number 2; workspace number 2
    bindsym 3                      move container to workspace number 3; workspace number 3
    bindsym 4                      move container to workspace number 4; workspace number 4
    bindsym 5                      move container to workspace number 5; workspace number 5
    bindsym 6                      move container to workspace number 6; workspace number 6
    bindsym 7                      move container to workspace number 7; workspace number 7
    bindsym 8                      move container to workspace number 8; workspace number 8
    bindsym 9                      move container to workspace number 9; workspace number 9

    bindsym $tc Control+h          move left  5 px
    bindsym $tc Control+j          move down  5 px
    bindsym $tc Control+k          move up    5 px
    bindsym $tc Control+l          move right 5 px

    bindsym $tc h                  move left  20 px
    bindsym $tc j                  move down  20 px
    bindsym $tc k                  move up    20 px
    bindsym $tc l                  move right 20 px

    bindsym $tc Shift+h            move left  50 px
    bindsym $tc Shift+j            move down  50 px
    bindsym $tc Shift+k            move up    50 px
    bindsym $tc Shift+l            move right 50 px

    bindsym $tc Control+Shift+h    move left  150 px
    bindsym $tc Control+Shift+j    move down  150 px
    bindsym $tc Control+Shift+k    move up    150 px
    bindsym $tc Control+Shift+l    move right 150 px

    bindsym Escape                 mode "default"
    bindsym Return                 mode "default"
    bindsym $tc q                  mode "default"
    bindsym $tc $mod+m             mode "default"
}

bindsym XF86Launch1 mode "POWER"
bindsym $tc $mod+p mode "POWER"
mode "POWER" {
    bindsym $tc s                  exec powerprofilesctl set power-saver && $msg_asus "Profile: Power Saver"; mode "default"
    bindsym $tc b                  exec powerprofilesctl set balanced && $msg_asus "Profile: Balanced"; mode "default"
    bindsym $tc p                  exec powerprofilesctl set performance && $msg_asus "Profile: Performance"; mode "default"
    bindsym $tc l                  exec asusctl battery limit 60 && $msg_asus "Battery: Limit set to 60%"; mode "default"
    bindsym $tc f                  exec asusctl battery oneshot && $msg_asus "Battery: Charging to 100%"; mode "default"

    bindsym Escape                 mode "default"
    bindsym Return                 mode "default"
    bindsym XF86Launch1            mode "default"
    bindsym $tc q                  mode "default"
    bindsym $tc $mod+p             mode "default"
}

bindsym $tc $mod+e mode "EXEC"
mode "EXEC" {
    bindsym $tc l                  exec $scripts/lock-nosentry.sh; mode "default"
    bindsym $tc s                  exec "swaylock -f && $scripts/sentry.sh"; mode "default"
    bindsym $tc e                  exec powermenu logout; mode "default"
    bindsym $tc r                  exec powermenu reboot; mode "default"
    bindsym $tc p                  exec powermenu poweroff; mode "default"

    bindsym $tc t                  exec tearing -n; mode "default"
    bindsym $tc n                  exec bluelight toggle; mode "default"
    bindsym $tc v                  exec swaymsg '[app_id="pulsemixer"] scratchpad show' || $pulse_term pulsemixer; mode "default"

    bindsym $tc w                  exec 'nmcli radio wifi on && $msg_sys "Network: ON"'; mode "default"
    bindsym $tc Shift+w            exec 'nmcli radio wifi off && $msg_sys "Network: OFF"'; mode "default"
    bindsym $tc Control+w          exec $float_term nmtui-go; mode "default"

    bindsym $tc b                  exec 'bluetoothctl power on && $msg_sys "Bluetooth: ON"'; mode "default"
    bindsym $tc Shift+b            exec 'bluetoothctl power off && $msg_sys "Bluetooth: OFF"'; mode "default"
    bindsym $tc Control+b          exec $float_term bluetuith; mode "default"

    bindsym Escape                 mode "default"
    bindsym Return                 mode "default"
    bindsym $tc q                  mode "default"
    bindsym $tc $mod+e             mode "default"
}
