#!/usr/bin/env bash
# ~/dots/bin/.local/bin/screenshot

set -euo pipefail

ACTION="${1:-}"
FREEZE_PID=""

IS_COPY=false
TARGET="$ACTION"
if [[ "$ACTION" == *"-copy" ]]; then
    IS_COPY=true
    TARGET="${ACTION%-copy}"
fi

cleanup() {
    if [[ -n "$FREEZE_PID" ]]; then
        kill "$FREEZE_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

get_window_geometry() {
    swaymsg -t get_tree |
        jq -r '.. | select(.focused? == true and (.type? == "con" or .type? == "floating_con")) | 
               "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"' |
        head -n1
}

case "$TARGET" in
region)
    wayfreeze &
    FREEZE_PID=$!

    sleep 0.1

    GEOM=$(slurp -d -w 1 -c "#78a9ff" -s "#78a9ff1a" -b "#0f0f0f55") || exit 0
    [[ -z "$GEOM" ]] && exit 0
    ;;
window)
    GEOM=$(get_window_geometry)
    [[ -z "$GEOM" ]] && exit 0
    ;;
fullscreen)
    GEOM=""
    ;;
*)
    echo "Usage: $0 [region|window|fullscreen|region-copy|window-copy|fullscreen-copy]"
    exit 1
    ;;
esac

declare -a grim_args=()
if [[ -n "$GEOM" ]]; then
    grim_args+=(-g "$GEOM")
fi

if [[ "$IS_COPY" == true ]]; then
    grim "${grim_args[@]}" - | wl-copy
    if [[ -n "$FREEZE_PID" ]]; then
        kill "$FREEZE_PID" 2>/dev/null || true
        FREEZE_PID=""
    fi
    notify-send -t 2000 "Screenshot" "Copied to clipboard"
else
    (
        grim -t ppm "${grim_args[@]}" -
        if [[ -n "$FREEZE_PID" ]]; then
            kill "$FREEZE_PID" 2>/dev/null || true
            FREEZE_PID=""
        fi
    ) | satty --filename -
fi
