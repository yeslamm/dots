#!/usr/bin/env bash
# ~/.local/bin/sway-run

if [ -n "$WAYLAND_DISPLAY" ]; then
    echo "You are already inside an active Wayland session!"
    exit 0
fi

if pgrep -u "$USER" -x sway >/dev/null; then
    echo "Error: Sway is already running for user $USER on another TTY!"
    echo "Returning to console safely to prevent D-Bus socket corruption."
    sleep 2
    exit 1
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway
export XDG_SESSION_DESKTOP=sway
export TERMINAL=foot

export XCURSOR_THEME=capitaine-cursors-r3
export XCURSOR_SIZE=24

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=qt5ct
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export ELECTRON_ENABLE_FEATURES=VaapiVideoDecoder,UseOzonePlatform
export _JAVA_AWT_WM_NONREPARENTING=1

export LIBVA_DRIVER_NAME=radeonsi
export VDPAU_DRIVER=radeonsi
export AMD_VULKAN_ICD=radv

exec sway
