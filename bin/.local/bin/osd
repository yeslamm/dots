#!/usr/bin/env bash
# ~/dots/bin/.local/bin/osd

set -euo pipefail

TARGET="${1:-}"
ACTION="${2:-}"
WOB_SOCK="${XDG_RUNTIME_DIR:-/run/user/${UID}}/wob.sock"
STEP="5"

case "$TARGET" in
volume)
    case "$ACTION" in
    up) wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "${STEP}%+" ;;
    down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "${STEP}%-" ;;
    mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    *)
        echo "Usage: $(basename "$0") volume [up|down|mute]" >&2
        exit 1
        ;;
    esac
    ;;
brightness)
    case "$ACTION" in
    up) brightnessctl set "${STEP}%+" -q ;;
    down) brightnessctl set "${STEP}%-" -q ;;
    *)
        echo "Usage: $(basename "$0") brightness [up|down]" >&2
        exit 1
        ;;
    esac
    ;;
*)
    echo "Usage: $(basename "$0") [volume|brightness] [action]" >&2
    exit 1
    ;;
esac

if pgrep -x wob >/dev/null && [[ -p "$WOB_SOCK" ]]; then
    VALUE=""
    case "$TARGET" in
    volume)
        VAL_RAW=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
        if [[ "$VAL_RAW" == *"[MUTED]"* ]]; then
            VALUE=0
        else
            VALUE=$(awk '{printf "%.0f", $2 * 100}' <<<"$VAL_RAW")
        fi
        ;;
    brightness)
        IFS=',' read -r _ _ _ PERC _ <<<"$(brightnessctl -m)"
        VALUE="${PERC%?}"
        ;;
    esac

    [[ -n "$VALUE" ]] && echo "$VALUE" >"$WOB_SOCK"
fi
