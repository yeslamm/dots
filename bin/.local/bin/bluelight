#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bluelight/config"

LAT="0.0"
LON="0.0"
NIGHT_TEMP="4500"
DAY_TEMP="6500"

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

ACTION="${1:-toggle}"

run_sunset() {
    wlsunset -l "$LAT" -L "$LON" -t "$NIGHT_TEMP" -T "$DAY_TEMP" >/dev/null 2>&1 &
}

case "$ACTION" in
on)
    pgrep -x wlsunset >/dev/null || run_sunset
    ;;

off)
    pkill -x wlsunset 2>/dev/null || true
    ;;

toggle)
    if pkill -x wlsunset 2>/dev/null; then
        notify-send -t 1200 -h string:x-canonical-private-synchronous:bluelight "Bluelight Filter: OFF"
    else
        run_sunset
        notify-send -t 1200 -h string:x-canonical-private-synchronous:bluelight "Bluelight Filter: ON"
    fi
    ;;

*)
    echo "Usage: $(basename "$0") [on|off|toggle]" >&2
    exit 1
    ;;
esac
