#!/usr/bin/env bash
# ~/dots/bin/.local/bin/bluelight

set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/bluelight/config"

LAT="0.0"
LON="0.0"
NIGHT_TEMP="4500"
DAY_TEMP="6500"

if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

ACTION="${1:-toggle}"

run_sunset() {
    wlsunset -l "$LAT" -L "$LON" -t "$NIGHT_TEMP" -T "$DAY_TEMP" &
}

case "$ACTION" in
on)
    pgrep -x wlsunset >/dev/null || run_sunset
    ;;

off)
    pkill -x wlsunset || true
    ;;

toggle)
    if pkill -x wlsunset; then
        notify-send "Bluelight Filter: OFF" \
            -t 1500 -h string:x-canonical-private-synchronous:gamma
    else
        run_sunset
        notify-send "Bluelight Filter: ON" \
            -t 1500 -h string:x-canonical-private-synchronous:gamma
    fi
    ;;

*)
    echo "Usage: $(basename "$0") [on|off|toggle]" >&2
    exit 1
    ;;
esac
