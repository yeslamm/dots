#!/usr/bin/env bash
# ~/dots/bin/.local/bin/powermenu

set -euo pipefail

ACTION="${1:-}"

[[ -z "$ACTION" ]] && echo "Usage: $(basename "$0") {exit|reboot|poweroff}" >&2 && exit 1

CONFIRM=$(printf "Yes\nNo\n" | fuzzel --dmenu --lines=2 --prompt="Confirm ${ACTION^}? " -w 30 || true)

[[ "$CONFIRM" != "Yes" ]] && exit 0

case "$ACTION" in
exit)
    swaymsg exit
    ;;
reboot)
    systemctl reboot
    ;;
poweroff)
    systemctl poweroff
    ;;
*)
    echo "Usage: $(basename "$0") {exit|reboot|poweroff}" >&2
    exit 1
    ;;
esac
