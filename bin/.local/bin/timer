#!/usr/bin/env bash
set -euo pipefail

SOUND_FILE="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
STATE_FILE="${XDG_RUNTIME_DIR:-/run/user/${UID}}/timer.state"

TAG_INFO="string:x-canonical-private-synchronous:timer-info"
TAG_ALERT="string:x-canonical-private-synchronous:timer-alert"
SCRIPT="$(readlink -f "$0")"

notify_info() {
    local body="$1" timeout="${2:-2000}" urgency="${3:-normal}"
    notify-send -h "$TAG_INFO" -u "$urgency" -t "$timeout" "Timer" "$body"
}

notify_alert() {
    notify-send -h "$TAG_ALERT" -u critical -t 0 "Timer" "Time's up!"
}

clear_alert() {
    makoctl dismiss -g "$TAG_ALERT" 2>/dev/null || true
}

update_waybar() {
    pkill -RTMIN+13 waybar 2>/dev/null || true
}

kill_timer() {
    local was_active=1
    if [ -f "$STATE_FILE" ]; then
        read -r pid _ <"$STATE_FILE" || true
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            pkill -P "$pid" 2>/dev/null || true
            kill "$pid" 2>/dev/null || true
            was_active=0
        fi
        rm -f "$STATE_FILE"
    fi
    if pkill -f "$SOUND_FILE" 2>/dev/null; then
        was_active=0
    fi

    clear_alert
    update_waybar
    return $was_active
}

start_timer() {
    local raw="${1:-45m}"
    local total_seconds=2700

    if [[ "$raw" =~ ^([0-9]+)[mM]$ ]]; then
        total_seconds=$((BASH_REMATCH[1] * 60))
    elif [[ "$raw" =~ ^([0-9]+)[sS]?$ ]]; then
        total_seconds="${BASH_REMATCH[1]}"
    else
        notify_info "Invalid format. Use Xm or Xs" 3000 "critical"
        exit 1
    fi

    if [ "$total_seconds" -le 0 ]; then
        total_seconds=60
    fi

    kill_timer || true

    if [ "$total_seconds" -ge 60 ] && [ $((total_seconds % 60)) -eq 0 ]; then
        notify_info "$((total_seconds / 60))m remaining" 3000 "normal"
    else
        notify_info "${total_seconds}s remaining" 3000 "normal"
    fi

    (
        sleep "$total_seconds"
        exec "$SCRIPT" alert
    ) >/dev/null 2>&1 &

    echo "$! $(($(date +%s) + total_seconds))" >"$STATE_FILE"
    update_waybar
}

get_time() {
    if [ -f "$STATE_FILE" ]; then
        local pid="" target=""
        read -r pid target <"$STATE_FILE" || true
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            local rem=$((target - $(date +%s)))
            if [ "$rem" -gt 0 ]; then
                printf "%dm %02ds remaining\n" $((rem / 60)) $((rem % 60))
                return 0
            else
                echo "Time's up"
                return 0
            fi
        fi
    fi
    echo "Inactive"
}

ACTION="${1:-}"

case "$ACTION" in
*[0-9]m | *[0-9]s | *[0-9])
    start_timer "$ACTION"
    ;;
stop)
    if kill_timer; then
        notify_info "Stopped" 1500 "low"
    fi
    ;;
alert)
    trap 'pkill -P $$ 2>/dev/null || true; exit 0' TERM INT EXIT

    target=0
    if [ -f "$STATE_FILE" ]; then
        read -r _ target <"$STATE_FILE" || true
    fi
    echo "$$ ${target:-0}" >"$STATE_FILE"

    notify_alert
    update_waybar

    while true; do
        pw-play "$SOUND_FILE" 2>/dev/null || paplay "$SOUND_FILE" 2>/dev/null || true
        sleep 1
    done
    ;;
show)
    notify_info "$(get_time)" 2000 "low"
    ;;
time)
    get_time
    ;;
start | "")
    start_timer "${2:-45m}"
    ;;
*)
    start_timer "$ACTION"
    ;;
esac
