# =============================================================================
# OPTIMIZED SWAYIMG CONFIGURATION (FIXED VIM BINDINGS)
# =============================================================================

[general]
mode = viewer
decoration = no
app_id = swayimg

[viewer]
window = #000000ff
transparency = grid
scale = optimal
antialiasing = mks13
loop = yes
history = 5
preload = 1

[gallery]
# THUMBNAIL SIZE
size = 300

# VISUALS
# 'fit' ensures you see the full image (no cropping).
# Options: fit | fill | keep
aspect = fit

# Background color of non-selected tiles
background = #202020ff

# Background color of the SELECTED tile
select = #404040ff

# Border color of the SELECTED tile (Fixed key name)
border_color = #ffffffaa

# PERFORMANCE
pstore = yes
cache = 500
preload = yes

[list]
order = alpha
all = yes
recursive = no

[slideshow]
time = 4

[font]
name = Monospace
size = 14
color = #ffffffff
shadow = #000000ff
background = #00000000

[info]
show = yes
info_timeout = 5
padding = 10

[info.viewer]
top_left = +name
top_right = +index
bottom_left = +imagesize, +filesize, +format
bottom_right = +exif

# =============================================================================
# OPTIMIZED KEYBINDINGS
# =============================================================================

[keys.viewer]
# --- PANNING / MOVEMENT (Vim Style) ---
# Use h/j/k/l to move INSIDE the image (pan)
h = step_left 10
j = step_down 10
k = step_up 10
l = step_right 10

# Arrow keys as backup
Left = step_left 10
Down = step_down 10
Up = step_up 10
Right = step_right 10

# --- FILE NAVIGATION ---
# n = next, p = previous (Common Vim pattern)
n = next_file
p = prev_file

# Space/Backspace are excellent for quick browsing
Space = next_file
BackSpace = prev_file

# --- ZOOMING ---
# + and - for zooming
Equal = zoom +10
Minus = zoom -10
# 0 to reset to 100% (1:1 pixel mapping)
0 = zoom real
# f to toggle fullscreen
f = fullscreen
# z to fit image to window (zoom fit)
z = zoom fit
# Z (Shift+z) to fill the window (zoom fill)
Shift+z = zoom fill

# --- MANIPULATION ---
# r to rotate
r = rotate_right
Shift+r = rotate_left
# m to mirror/flip
m = flip_vertical
Shift+m = flip_horizontal

# --- SYSTEM ---
q = exit
Escape = exit
# Toggle gallery mode with 'g'
g = mode gallery

[keys.gallery]
# Navigation in gallery mode
h = step_left
j = step_down
k = step_up
l = step_right

# Enter viewer mode
Enter = mode viewer
f = fullscreen
q = exit
Escape = exit
