################ .zshenv ###################

# 1. System Paths
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"
export PATH="${PATH}:/opt/rocm/bin"

# 2. Default Programs
export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"

# 3. CLI Tool Configs
export LESSHISTFILE="-"

###########################################
