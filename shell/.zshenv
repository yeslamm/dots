################ .zshenv ###################

export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.fzf/bin:$PATH"
export PATH="${PATH}:/opt/rocm/bin"

export EDITOR="nvim"
export VISUAL="nvim"
export PAGER="less"
export MANPAGER="less -R --use-color -Dd+G -Du+C -DSkY -DPB -DNb -DTb -DER -DCm -DWY -DHY"
export MANROFFOPT="-c"

export LESSHISTFILE="-"

###########################################
